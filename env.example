# Copy this file to .env for local development, and add the same two
# values as environment variables in your hosting provider (Vercel/Netlify)
# for the live deployment. Get these from your Supabase project settings
# under Project Settings > API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
